# Settings for docker compose. To change any, copy this file to .env and edit it:
#   cp .env.example .env
# A line that starts with # is off, and that setting keeps its default.
# Put a value in single quotes if it contains $ or spaces, for example PASSWORD='my$ecret pass'.
# Apply changes with: docker compose up -d

# ---------------------------------------------------------------------------------------
# This app
# ---------------------------------------------------------------------------------------
# Port on this computer for the app: http://127.0.0.1:8080/ui/
APP_PORT=8080
# Who can reach that port: 127.0.0.1 = this computer only, 0.0.0.0 = your whole network (turn on a login below first).
APP_BIND=127.0.0.1
# Your own transcripts and the bundled demo pack (scripts/load-demo.sh) live under ./data/companion/library; compose.yaml already points the companion at it (PODCAST_LIBRARY), so there is nothing to set here.

# ---------------------------------------------------------------------------------------
# AI with your own key: briefs, cuts and questions (the companion). Any OpenAI-compatible API.
# ---------------------------------------------------------------------------------------
# API address: Groq https://api.groq.com/openai/v1 · OpenAI https://api.openai.com/v1 · OpenRouter https://openrouter.ai/api/v1 · Ollama http://ollama:11434/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Your API key for that provider. It stays on this server.
# LLM_API_KEY=
# Model id, from your provider's model list.
# LLM_MODEL=
# Also run a local Ollama server (profile local-ai); then set LLM_BASE_URL=http://ollama:11434/v1.
# COMPOSE_PROFILES=local-ai
# Let the companion download feeds and audio from your own network (LAN addresses are refused by default).
# ALLOW_PRIVATE_FEEDS=true

# ---------------------------------------------------------------------------------------
# Transcripts for episodes without one: PodFetch sends the downloaded episode file to any
# OpenAI-compatible speech-to-text API. Groq has a free tier, but it limits the upload
# size, so long episodes can fail there.
# ---------------------------------------------------------------------------------------
# API address without /v1: Groq https://api.groq.com/openai · OpenAI https://api.openai.com
# TRANSCRIPTION_API_BASE_URL=https://api.groq.com/openai
# API key for that service, if it needs one.
# TRANSCRIPTION_API_KEY=
# Model name (default whisper-1, OpenAI's); on Groq use whisper-large-v3-turbo.
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Imported videos reuse this speech provider for chunked, full-audio transcription.
# Without it, a speech-capable provider chosen in Settings → AI is used.
# Optional visual review handoff. Both addresses must be set; preparing a review
# transfers the video but never runs vision automatically. The browser address must
# be reachable by your learners. Course Watcher reviews currently accept up to 30 min.
# COURSE_WATCHER_URL=http://course-watcher:8000
# COURSE_WATCHER_PUBLIC_URL=https://your-course-watcher.example

# ---------------------------------------------------------------------------------------
# Login (PodFetch). Turn on at most one: BASIC_AUTH, OIDC_AUTH or REVERSE_PROXY.
# ---------------------------------------------------------------------------------------
# Log in with a username and password.
# BASIC_AUTH=true
# Admin username for BASIC_AUTH.
# USERNAME=admin
# Admin password for BASIC_AUTH.
# PASSWORD=
# Admin API key for scripts and API clients (off unless set).
# API_KEY=
# Log in through your own OpenID Connect provider (Keycloak, Authelia, ...).
# OIDC_AUTH=true
# OIDC issuer URL.
# OIDC_AUTHORITY=
# OIDC client id.
# OIDC_CLIENT_ID=
# URL your provider sends users back to after login.
# OIDC_REDIRECT_URI=
# OIDC JWKS URL (required with OIDC_AUTH).
# OIDC_JWKS=
# OIDC scopes (default: openid profile email).
# OIDC_SCOPE=openid profile email
# How often to refresh the OIDC keys, in milliseconds (default 120000).
# OIDC_REFRESH_INTERVAL=120000
# Trust a login header set by your own reverse proxy (only if nobody can reach this app around that proxy).
# REVERSE_PROXY=true
# Header that holds the username (default X-Forwarded-User).
# REVERSE_PROXY_HEADER=X-Forwarded-User
# Create an account for a new username from that header automatically.
# REVERSE_PROXY_AUTO_SIGN_UP=true

# ---------------------------------------------------------------------------------------
# Podcasts (PodFetch)
# ---------------------------------------------------------------------------------------
# Minutes between checks for new episodes (default 300).
# POLLING_INTERVAL=300
# Podcasts each non-admin user may add (default 0: only admins and uploaders can add).
# USER_PODCAST_LIMIT=0
# Podcast Index key, for podcast search (free at https://api.podcastindex.org).
# PODINDEX_API_KEY=
# Podcast Index secret.
# PODINDEX_API_SECRET=
# Send PodFetch's outgoing requests through this proxy, for example http://proxy:3128.
# PODFETCH_PROXY=
# Sponsor skipping uses Podsift's own timed-transcript detector.
# Compose disables the inherited SponsorBlock data client; no external database is needed.

# ---------------------------------------------------------------------------------------
# Other apps (PodFetch)
# ---------------------------------------------------------------------------------------
# Sync with AntennaPod and other gpodder apps (needs a login turned on above).
# GPODDER_INTEGRATION_ENABLED=true
# Let the Audiobookshelf phone apps connect.
# AUDIOBOOKSHELF_INTEGRATION_ENABLED=true
# Folder inside the container for Audiobookshelf covers and stream cache (default audiobookshelf).
# AUDIOBOOKSHELF_DATA_DIR=audiobookshelf
# Stream cache limit in MB (default 2048).
# AUDIOBOOKSHELF_HLS_CACHE_MAX_MB=2048
# Streams converted at the same time (default 2).
# AUDIOBOOKSHELF_TRANSCODER_MAX_CONCURRENT=2
# Logging out in the app signs out your other devices too.
# AUDIOBOOKSHELF_ROTATE_API_KEY_ON_LOGOUT=true
# Let a Mopidy music server browse and play your podcasts.
# MOPIDY_INTEGRATION_ENABLED=true
# Send notifications to Telegram.
# TELEGRAM_API_ENABLED=true
# Telegram bot token (from @BotFather).
# TELEGRAM_BOT_TOKEN=
# Telegram chat id that gets the messages.
# TELEGRAM_BOT_CHAT_ID=

# ---------------------------------------------------------------------------------------
# Store episode files in S3 instead of ./data (PodFetch)
# ---------------------------------------------------------------------------------------
# Set to s3 to use S3.
# FILE_HANDLER=s3
# S3 endpoint (default http://localhost:9000).
# S3_URL=
# S3 region (default eu-central-1).
# S3_REGION=eu-central-1
# S3 access key.
# S3_ACCESS_KEY=
# S3 secret key.
# S3_SECRET_KEY=
# S3 profile, if you use one.
# S3_PROFILE=
# S3 security token, if you use one.
# S3_SECURITY_TOKEN=
# S3 session token, if you use one.
# S3_SESSION_TOKEN=
# Bucket name (default podcasts). Only for S3: without S3 it moves episode files outside ./data.
# PODFETCH_FOLDER=podcasts

# compose.yaml sets PORT, DATABASE_URL and SUB_DIRECTORY itself; setting them here has no effect.
